{
  "name": "neon-atlas",
  "version": "1.0.0",
  "private": true,
  "description": "Neon Atlas: an independent, unofficial GTA VI guide. Static site + editorial tools.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node src/build.mjs",
    "build:preview": "PREVIEW=1 node src/build.mjs",
    "serve": "node tools/serve.mjs",
    "dev": "node src/build.mjs && node tools/serve.mjs",
    "check": "node src/build.mjs && node tools/check.mjs",
    "test:browser": "node tools/browser-test.mjs",
    "test": "node src/build.mjs && node tools/check.mjs && node tools/browser-test.mjs",
    "report": "node tools/editorial.mjs report",
    "editorial": "node tools/editorial.mjs",
    "keywords": "node tools/keywords.mjs",
    "cms": "npx --yes decap-server@3.11.3",
    "ship": "node tools/ship.mjs",
    "live": "node tools/editorial.mjs live",
    "watch": "node tools/watch-official.mjs",
    "fetch-official": "node tools/fetch-official.mjs",
    "indexnow": "node tools/indexnow.mjs",
    "art": "node tools/make-art.mjs",
    "import-official": "node tools/import-official.mjs"
  },
  "dependencies": {
    "gray-matter": "4.0.3",
    "marked": "18.1.2"
  },
  "optionalDependencies": {
    "@anthropic-ai/sdk": "1.3.0"
  },
  "devDependencies": {
    "axe-core": "^4.10.3"
  }
}