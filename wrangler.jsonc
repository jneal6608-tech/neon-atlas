// Cloudflare Workers static-site config: serves the built site in dist/.
// (Used when the Cloudflare project is a Worker; Pages projects ignore this file.)
{
  "name": "neonatlas",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
